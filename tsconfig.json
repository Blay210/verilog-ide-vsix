{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vscode"
    ],
    "baseUrl": ".",
    "paths": {
      "@rtl-dev/semantic": [
        "packages/semantic/src/index.ts"
      ],
      "@rtl-dev/language": [
        "packages/language/src/index.ts"
      ],
      "@rtl-dev/core": [
        "packages/core/src/index.ts"
      ],
      "@rtl-dev/verilator": [
        "packages/verilator/src/index.ts"
      ],
      "@rtl-dev/toolchain": [
        "packages/toolchain/src/index.ts"
      ],
      "@rtl-dev/waveform": [
        "packages/waveform/src/index.ts"
      ],
      "@rtl-dev/waveform/client": [
        "packages/waveform/src/client.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts"
  ]
}
