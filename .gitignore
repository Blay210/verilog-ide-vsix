# Dependencies and generated builds (all workspaces)
node_modules/
dist/
*.tsbuildinfo

# Local toolchains, isolated editor profiles, and verification artifacts
/.dev/
.rtl/
/.codex/
/.aws/

# Distribution artifacts
*.vsix
*.tgz

# Files copied/generated by scripts/package.mjs
/packages/vscode/README.md
/packages/vscode/LICENSE
/packages/vscode/docs/
/packages/vscode/THIRD-PARTY-NOTICES.txt

# Test coverage and package-manager logs
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local secrets; keep shareable example files
.env
.env.*
!.env.example
!.env.sample
.npmrc

# OS/editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Keep sources, tests, docs, examples, package-lock.json, and shared
# .vscode/launch.json + tasks.json in Git. Do not exclude *.sv, *.v,
# *.vcd, or *.json globally: these can be source/config/test fixtures.
