{
  "comments": {"lineComment":"//","blockComment":["/*","*/"]},
  "brackets": [["(",")"],["[","]"],["{","}"]],
  "autoClosingPairs": [
    {"open":"(","close":")","notIn":["string","comment"]},
    {"open":"[","close":"]","notIn":["string","comment"]},
    {"open":"{","close":"}","notIn":["string","comment"]},
    {"open":"\"","close":"\"","notIn":["string","comment"]}
  ],
  "surroundingPairs": [["(",")"],["[","]"],["{","}"],["\"","\""]],
  "wordPattern": "\\$?[A-Za-z_][A-Za-z0-9_$]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!//).*\\b(?:begin(?:\\s*:\\s*[A-Za-z_][\\w$]*)?|fork(?:\\s*:\\s*[A-Za-z_][\\w$]*)?|(?:case|casex|casez)\\s*\\(.*\\)(?:\\s+(?:inside|matches))?)\\s*(?://.*)?$|^\\s*(?:virtual\\s+)?class\\s+[A-Za-z_][\\w$]*[^;]*;\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*(?:end|endcase|endmodule|endfunction|endtask|endpackage|endinterface|endclass|endgenerate|join|join_any|join_none)\\b"
  }
}
